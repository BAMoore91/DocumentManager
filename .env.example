# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Vercel Blob (created automatically when you add Blob storage on Vercel)
BLOB_READ_WRITE_TOKEN=""

# Seed credentials for the bootstrap super admin
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="changeme123!"

# Anthropic API key — powers the SDS Find/Refresh/Extract AI features.
# Without this key the AI features degrade gracefully (manual upload still works).
ANTHROPIC_API_KEY=""

# How many SDSes the cron checks per run (default 25)
SDS_CHECK_BATCH_SIZE="25"

# Sheets with a revision date older than this many years are flagged stale (default 3)
SDS_AGE_STALE_YEARS="3"

# Cron secret for /api/cron/* routes
CRON_SECRET=""
