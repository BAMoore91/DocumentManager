# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Vercel Blob (created automatically when you add Blob storage on Vercel)
BLOB_READ_WRITE_TOKEN=""

# Seed credentials for the bootstrap super admin
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="changeme123!"
