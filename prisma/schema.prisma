generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  CHECKBOX
  CHECKBOXES
  SELECT
}

enum JhaSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JhaStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  TOOLBOX_TALK_ASSIGNED
  FORUM_REPLY
  CAPA_ASSIGNED
}

enum IncidentType {
  NEAR_MISS
  FIRST_AID
  RECORDABLE
  RESTRICTED_DUTY
  LOST_TIME
  FATALITY
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  VERIFIED
  CLOSED
}

enum CorrectiveActionSourceType {
  JHA
  INCIDENT
  AUDIT
  OBSERVATION
  OTHER
}

enum CorrectiveActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

enum InspectionResult {
  PASS
  FAIL_NEEDS_REPAIR
  FAIL_OUT_OF_SERVICE
}

enum PermitType {
  HOT_WORK
  CONFINED_SPACE
  LOCKOUT_TAGOUT
  WORKING_AT_HEIGHTS
  ELECTRICAL
  EXCAVATION
  OTHER
}

enum PermitStatus {
  DRAFT
  ISSUED
  EXPIRED
  CLOSED
}

enum AuditStatus {
  IN_PROGRESS
  COMPLETED
}

enum AuditItemResult {
  PASS
  FAIL
  NA
}

enum PtpStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  documents         Document[]
  events            CalendarEvent[]
  customRoles       CustomRole[]
  toolboxTalks      ToolboxTalk[]
  requiredDocuments RequiredDocument[]
  forms             Form[]
  forumTopics       ForumTopic[]
  kbArticles        KbArticle[]
  jhaReports        JhaReport[]
  sdsSheets         SdsSheet[]
  incidents         Incident[]
  sites             Site[]
  correctiveActions CorrectiveAction[]
  trainingCourses   TrainingCourse[]
  trainingRecords   TrainingRecord[]
  equipment         Equipment[]
  permits           Permit[]
  audits            Audit[]
  preTaskPlans      PreTaskPlan[]
  subcontractors    Subcontractor[]
  auditTemplates    AuditTemplate[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  role           Role     @default(USER)
  organizationId String?
  customRoleId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole        CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  documents         Document[]    @relation("DocumentOwner")
  uploadedDocuments Document[]    @relation("DocumentUploader")
  createdEvents     CalendarEvent[] @relation("EventCreator")
  presentedTalks    ToolboxTalk[] @relation("TalkPresenter")
  createdTalks      ToolboxTalk[] @relation("TalkCreator")
  talkAttendances   ToolboxTalkAttendance[] @relation("TalkAttendee")
  assignedTalks     ToolboxTalk[] @relation("TalkAssignedUsers")
  createdForms      Form[]        @relation("FormCreator")
  formSubmissions   FormSubmission[] @relation("FormSubmitter")
  forumTopics       ForumTopic[]  @relation("ForumTopicAuthor")
  forumReplies      ForumReply[]  @relation("ForumReplyAuthor")
  kbArticles        KbArticle[]   @relation("KbArticleAuthor")
  jhaReports        JhaReport[]   @relation("JhaReporter")
  sdsSheets         SdsSheet[]    @relation("SdsUploader")
  notifications     Notification[] @relation("UserNotifications")
  reportedIncidents Incident[]    @relation("IncidentReporter")
  incidentsAsPerson Incident[]    @relation("IncidentPersonInvolved")
  capaCreated       CorrectiveAction[] @relation("CapaCreator")
  capaAssigned      CorrectiveAction[] @relation("CapaAssignee")
  capaVerified      CorrectiveAction[] @relation("CapaVerifier")
  trainingRecords   TrainingRecord[]   @relation("TrainingRecordUser")
  trainingRecorded  TrainingRecord[]   @relation("TrainingRecordedBy")
  inspections       EquipmentInspection[] @relation("InspectionPerformer")
  permitsIssued     Permit[]           @relation("PermitIssuer")
  permitsReceived   Permit[]           @relation("PermitRecipient")
  auditsConducted   Audit[]            @relation("AuditConductor")
  ptpsCreated       PreTaskPlan[]      @relation("PtpCreator")
  ptpAcknowledgements PtpAcknowledgement[] @relation("PtpAcker")
  signatures        Signature[]        @relation("SignatureSigner")

  @@index([organizationId])
  @@index([customRoleId])
}

model Document {
  id                 String   @id @default(cuid())
  name               String
  type               String
  fileUrl            String
  fileName           String
  fileSize           Int
  mimeType           String
  expirationDate     DateTime
  notes              String?
  organizationId     String
  ownerId            String
  uploadedById       String
  requiredDocumentId String?
  siteId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy       User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  requiredDocument RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([expirationDate])
  @@index([requiredDocumentId])
  @@index([siteId])
}

model CustomRole {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                User[]
  requiredDocuments    RequiredDocument[]
  assignedToolboxTalks ToolboxTalk[]
  trainingCourses      TrainingCourse[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RequiredDocument {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoles  CustomRole[]
  documents    Document[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  description    String?
  date           DateTime
  organizationId String
  createdById    String
  siteId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("EventCreator", fields: [createdById], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([date])
  @@index([siteId])
}

model ToolboxTalk {
  id             String   @id @default(cuid())
  topic          String
  date           DateTime
  location       String?
  notes          String?
  organizationId String
  presenterId    String
  createdById    String
  siteId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  presenter     User         @relation("TalkPresenter", fields: [presenterId], references: [id])
  createdBy     User         @relation("TalkCreator", fields: [createdById], references: [id])
  site          Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  attendances   ToolboxTalkAttendance[]
  assignedRoles CustomRole[]
  assignedUsers User[]       @relation("TalkAssignedUsers")

  @@index([organizationId])
  @@index([date])
  @@index([presenterId])
  @@index([siteId])
}

model ToolboxTalkAttendance {
  id         String   @id @default(cuid())
  talkId     String
  userId     String
  attendedAt DateTime @default(now())

  talk ToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  user User        @relation("TalkAttendee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([talkId, userId])
  @@index([talkId])
  @@index([userId])
}

model Form {
  id             String     @id @default(cuid())
  name           String
  description    String?
  organizationId String
  status         FormStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("FormCreator", fields: [createdById], references: [id])
  fields       FormField[]
  submissions  FormSubmission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  position    Int           @default(0)
  options     String?
  placeholder String?
  createdAt   DateTime      @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([formId, position])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  values      Json
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation("FormSubmitter", fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model ForumTopic {
  id             String   @id @default(cuid())
  title          String
  body           String
  organizationId String
  authorId       String
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies      ForumReply[]

  @@index([organizationId])
  @@index([organizationId, pinned, updatedAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([authorId])
}

model JhaReport {
  id                String      @id @default(cuid())
  title             String
  location          String?
  hazardDescription String
  mitigation        String?
  severity          JhaSeverity @default(MEDIUM)
  status            JhaStatus   @default(OPEN)
  organizationId    String
  reportedById      String
  siteId            String?
  resolvedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User         @relation("JhaReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  photos       JhaPhoto[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([siteId])
}

model JhaPhoto {
  id        String   @id @default(cuid())
  jhaId     String
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  caption   String?
  createdAt DateTime @default(now())

  jha JhaReport @relation(fields: [jhaId], references: [id], onDelete: Cascade)

  @@index([jhaId])
}

model Incident {
  id                 String         @id @default(cuid())
  organizationId     String
  caseNumber         String?
  type               IncidentType
  status             IncidentStatus @default(OPEN)
  occurredAt         DateTime
  location           String?
  description        String

  personName         String
  personUserId       String?
  jobTitle           String?
  bodyPart           String?
  injuryType         String?

  daysAway           Int?
  daysRestricted     Int?
  treatmentReceived  String?

  rootCause          String?
  correctiveActions  String?

  reportedById       String
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy     User         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  personInvolved User?        @relation("IncidentPersonInvolved", fields: [personUserId], references: [id], onDelete: SetNull)
  photos         IncidentPhoto[]

  @@index([organizationId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, status])
}

model IncidentPhoto {
  id         String   @id @default(cuid())
  incidentId String
  fileUrl    String
  fileName   String
  fileSize   Int
  mimeType   String
  caption    String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model CorrectiveAction {
  id                 String                       @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  sourceType         CorrectiveActionSourceType
  sourceId           String?
  priority           CorrectiveActionPriority     @default(MEDIUM)
  status             CorrectiveActionStatus       @default(OPEN)
  assignedToId       String?
  createdById        String
  dueDate            DateTime?
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNotes  String?
  closedAt           DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CapaCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("CapaAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  verifiedBy   User?        @relation("CapaVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([sourceType, sourceId])
}

model TrainingCourse {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  description         String?
  defaultValidityDays Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoles  CustomRole[]
  records      TrainingRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TrainingRecord {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  courseId        String
  completedAt     DateTime
  expiresAt       DateTime?
  instructor      String?
  provider        String?
  certificateUrl  String?
  certificateName String?
  certificateSize Int?
  hours           Float?
  notes           String?
  recordedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation("TrainingRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  course       TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recordedBy   User            @relation("TrainingRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
}

model Site {
  id               String     @id @default(cuid())
  organizationId   String
  name             String
  code             String?
  address          String?
  status           SiteStatus @default(ACTIVE)
  contactName      String?
  contactPhone     String?
  emergencyContact String?
  musterPoint      String?
  notes            String?
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment      Equipment[]
  permits        Permit[]
  audits         Audit[]
  preTaskPlans   PreTaskPlan[]
  documents      Document[]
  events         CalendarEvent[]
  jhaReports     JhaReport[]
  toolboxTalks   ToolboxTalk[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Equipment {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  type           String?
  serialNumber   String?
  manufacturer   String?
  status         EquipmentStatus @default(ACTIVE)
  siteId         String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?                 @relation(fields: [siteId], references: [id], onDelete: SetNull)
  inspections  EquipmentInspection[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([siteId])
}

model EquipmentInspection {
  id            String           @id @default(cuid())
  equipmentId   String
  performedById String
  performedAt   DateTime         @default(now())
  result        InspectionResult
  defects       String?
  notes         String?
  outOfService  Boolean          @default(false)
  createdAt     DateTime         @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedBy User      @relation("InspectionPerformer", fields: [performedById], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([equipmentId, performedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  sourceId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([sourceId])
}

model SdsSheet {
  id             String   @id @default(cuid())
  productName    String
  manufacturer   String?
  casNumber      String?
  revisionDate   DateTime?
  notes          String?
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  organizationId String
  uploadedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("SdsUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, productName])
}

model KbArticle {
  id             String   @id @default(cuid())
  title          String
  body           String
  organizationId String
  authorId       String
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("KbArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, published])
}

model Permit {
  id             String       @id @default(cuid())
  organizationId String
  type           PermitType
  status         PermitStatus @default(DRAFT)
  title          String
  location       String?
  description    String?
  hazards        String?
  controls       String?
  validFrom      DateTime
  validUntil     DateTime
  issuedById     String
  recipientId    String?
  recipientName  String?
  siteId         String?
  closedAt       DateTime?
  closedNotes    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuedBy     User         @relation("PermitIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  recipient    User?        @relation("PermitRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, validUntil])
  @@index([siteId])
}

model Audit {
  id              String      @id @default(cuid())
  organizationId  String
  title           String
  conductedById   String
  conductedAt     DateTime
  siteId          String?
  templateId      String?
  status          AuditStatus @default(IN_PROGRESS)
  scoreNumerator  Int?
  scoreDenominator Int?
  findings        String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conductedBy  User            @relation("AuditConductor", fields: [conductedById], references: [id], onDelete: Cascade)
  site         Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  template     AuditTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  findingItems AuditFindingItem[]

  @@index([organizationId])
  @@index([organizationId, conductedAt])
  @@index([siteId])
  @@index([templateId])
}

model AuditTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        AuditTemplateItem[]
  audits       Audit[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AuditTemplateItem {
  id         String @id @default(cuid())
  templateId String
  label      String
  position   Int    @default(0)

  template AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([templateId, position])
}

model AuditFindingItem {
  id        String           @id @default(cuid())
  auditId   String
  label     String
  position  Int              @default(0)
  result    AuditItemResult?
  notes     String?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([auditId, position])
}

model PreTaskPlan {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  task           String
  date           DateTime
  siteId         String?
  hazards        String
  controls       String
  ppe            String?
  emergencyInfo  String?
  status         PtpStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("PtpCreator", fields: [createdById], references: [id], onDelete: Cascade)
  site             Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  acknowledgements PtpAcknowledgement[]

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([siteId])
}

model PtpAcknowledgement {
  id              String   @id @default(cuid())
  preTaskPlanId   String
  userId          String
  acknowledgedAt  DateTime @default(now())

  preTaskPlan PreTaskPlan @relation(fields: [preTaskPlanId], references: [id], onDelete: Cascade)
  user        User        @relation("PtpAcker", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([preTaskPlanId, userId])
  @@index([preTaskPlanId])
  @@index([userId])
}

model Subcontractor {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  trade          String?
  notes          String?
  insuranceUrl   String?
  insuranceName  String?
  insuranceSize  Int?
  insuranceExpiresAt DateTime?
  prequalified   Boolean   @default(false)
  prequalifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, insuranceExpiresAt])
}

model Signature {
  id             String   @id @default(cuid())
  signerId       String
  signerName     String
  contextType    String   // e.g. "TOOLBOX_TALK_ATTENDANCE", "PERMIT_RECIPIENT", "PTP_ACKNOWLEDGEMENT"
  contextId      String   // related record id
  imageDataUrl   String   @db.Text  // base64 PNG of the captured signature
  signedAt       DateTime @default(now())

  signer User @relation("SignatureSigner", fields: [signerId], references: [id], onDelete: Cascade)

  @@index([contextType, contextId])
  @@index([signerId])
}
