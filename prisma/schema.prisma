generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
}

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  CHECKBOX
  CHECKBOXES
  SELECT
}

enum JhaSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JhaStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  TOOLBOX_TALK_ASSIGNED
  FORUM_REPLY
  CAPA_ASSIGNED
}

enum IncidentType {
  NEAR_MISS
  FIRST_AID
  RECORDABLE
  RESTRICTED_DUTY
  LOST_TIME
  FATALITY
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  VERIFIED
  CLOSED
}

enum CorrectiveActionSourceType {
  JHA
  INCIDENT
  AUDIT
  OBSERVATION
  OTHER
}

enum CorrectiveActionPriority {
  LOW
  MEDIUM
  HIGH
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  documents         Document[]
  events            CalendarEvent[]
  customRoles       CustomRole[]
  toolboxTalks      ToolboxTalk[]
  requiredDocuments RequiredDocument[]
  forms             Form[]
  forumTopics       ForumTopic[]
  kbArticles        KbArticle[]
  jhaReports        JhaReport[]
  sdsSheets         SdsSheet[]
  incidents         Incident[]
  sites             Site[]
  correctiveActions CorrectiveAction[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  role           Role     @default(USER)
  organizationId String?
  customRoleId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole        CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  documents         Document[]    @relation("DocumentOwner")
  uploadedDocuments Document[]    @relation("DocumentUploader")
  createdEvents     CalendarEvent[] @relation("EventCreator")
  presentedTalks    ToolboxTalk[] @relation("TalkPresenter")
  createdTalks      ToolboxTalk[] @relation("TalkCreator")
  talkAttendances   ToolboxTalkAttendance[] @relation("TalkAttendee")
  assignedTalks     ToolboxTalk[] @relation("TalkAssignedUsers")
  createdForms      Form[]        @relation("FormCreator")
  formSubmissions   FormSubmission[] @relation("FormSubmitter")
  forumTopics       ForumTopic[]  @relation("ForumTopicAuthor")
  forumReplies      ForumReply[]  @relation("ForumReplyAuthor")
  kbArticles        KbArticle[]   @relation("KbArticleAuthor")
  jhaReports        JhaReport[]   @relation("JhaReporter")
  sdsSheets         SdsSheet[]    @relation("SdsUploader")
  notifications     Notification[] @relation("UserNotifications")
  reportedIncidents Incident[]    @relation("IncidentReporter")
  incidentsAsPerson Incident[]    @relation("IncidentPersonInvolved")
  capaCreated       CorrectiveAction[] @relation("CapaCreator")
  capaAssigned      CorrectiveAction[] @relation("CapaAssignee")
  capaVerified      CorrectiveAction[] @relation("CapaVerifier")

  @@index([organizationId])
  @@index([customRoleId])
}

model Document {
  id                 String   @id @default(cuid())
  name               String
  type               String
  fileUrl            String
  fileName           String
  fileSize           Int
  mimeType           String
  expirationDate     DateTime
  notes              String?
  organizationId     String
  ownerId            String
  uploadedById       String
  requiredDocumentId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedBy       User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  requiredDocument RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([expirationDate])
  @@index([requiredDocumentId])
}

model CustomRole {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users                User[]
  requiredDocuments    RequiredDocument[]
  assignedToolboxTalks ToolboxTalk[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RequiredDocument {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRoles  CustomRole[]
  documents    Document[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  description    String?
  date           DateTime
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("EventCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([date])
}

model ToolboxTalk {
  id             String   @id @default(cuid())
  topic          String
  date           DateTime
  location       String?
  notes          String?
  organizationId String
  presenterId    String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  presenter     User         @relation("TalkPresenter", fields: [presenterId], references: [id])
  createdBy     User         @relation("TalkCreator", fields: [createdById], references: [id])
  attendances   ToolboxTalkAttendance[]
  assignedRoles CustomRole[]
  assignedUsers User[]       @relation("TalkAssignedUsers")

  @@index([organizationId])
  @@index([date])
  @@index([presenterId])
}

model ToolboxTalkAttendance {
  id         String   @id @default(cuid())
  talkId     String
  userId     String
  attendedAt DateTime @default(now())

  talk ToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  user User        @relation("TalkAttendee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([talkId, userId])
  @@index([talkId])
  @@index([userId])
}

model Form {
  id             String     @id @default(cuid())
  name           String
  description    String?
  organizationId String
  status         FormStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("FormCreator", fields: [createdById], references: [id])
  fields       FormField[]
  submissions  FormSubmission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  position    Int           @default(0)
  options     String?
  placeholder String?
  createdAt   DateTime      @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([formId, position])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  values      Json
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation("FormSubmitter", fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model ForumTopic {
  id             String   @id @default(cuid())
  title          String
  body           String
  organizationId String
  authorId       String
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies      ForumReply[]

  @@index([organizationId])
  @@index([organizationId, pinned, updatedAt])
}

model ForumReply {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic  ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User       @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([authorId])
}

model JhaReport {
  id                String      @id @default(cuid())
  title             String
  location          String?
  hazardDescription String
  mitigation        String?
  severity          JhaSeverity @default(MEDIUM)
  status            JhaStatus   @default(OPEN)
  organizationId    String
  reportedById      String
  resolvedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User         @relation("JhaReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  photos       JhaPhoto[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model JhaPhoto {
  id        String   @id @default(cuid())
  jhaId     String
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  caption   String?
  createdAt DateTime @default(now())

  jha JhaReport @relation(fields: [jhaId], references: [id], onDelete: Cascade)

  @@index([jhaId])
}

model Incident {
  id                 String         @id @default(cuid())
  organizationId     String
  caseNumber         String?
  type               IncidentType
  status             IncidentStatus @default(OPEN)
  occurredAt         DateTime
  location           String?
  description        String

  personName         String
  personUserId       String?
  jobTitle           String?
  bodyPart           String?
  injuryType         String?

  daysAway           Int?
  daysRestricted     Int?
  treatmentReceived  String?

  rootCause          String?
  correctiveActions  String?

  reportedById       String
  closedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy     User         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  personInvolved User?        @relation("IncidentPersonInvolved", fields: [personUserId], references: [id], onDelete: SetNull)
  photos         IncidentPhoto[]

  @@index([organizationId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, status])
}

model IncidentPhoto {
  id         String   @id @default(cuid())
  incidentId String
  fileUrl    String
  fileName   String
  fileSize   Int
  mimeType   String
  caption    String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model CorrectiveAction {
  id                 String                       @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  sourceType         CorrectiveActionSourceType
  sourceId           String?
  priority           CorrectiveActionPriority     @default(MEDIUM)
  status             CorrectiveActionStatus       @default(OPEN)
  assignedToId       String?
  createdById        String
  dueDate            DateTime?
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNotes  String?
  closedAt           DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CapaCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("CapaAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  verifiedBy   User?        @relation("CapaVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([sourceType, sourceId])
}

model Site {
  id               String     @id @default(cuid())
  organizationId   String
  name             String
  code             String?
  address          String?
  status           SiteStatus @default(ACTIVE)
  contactName      String?
  contactPhone     String?
  emergencyContact String?
  musterPoint      String?
  notes            String?
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  sourceId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([sourceId])
}

model SdsSheet {
  id             String   @id @default(cuid())
  productName    String
  manufacturer   String?
  casNumber      String?
  revisionDate   DateTime?
  notes          String?
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  organizationId String
  uploadedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("SdsUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, productName])
}

model KbArticle {
  id             String   @id @default(cuid())
  title          String
  body           String
  organizationId String
  authorId       String
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("KbArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, published])
}
